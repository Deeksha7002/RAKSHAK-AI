{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "frontend/dist" }
    }
  ],
  "rewrites": [
    { "source": "/api/:match*", "destination": "https://scam-defender-honeypot-1-fi61.onrender.com/api/:match*" },
    { "source": "/:path((?!.*\\.).*)", "destination": "/index.html" }
  ]
}